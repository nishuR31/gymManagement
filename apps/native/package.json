{
  "name": "@gym/native",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "web": "bunx expo start --web",
    "build:web": "bunx expo export --platform web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "start": "EXPO_NO_DEV_TOOLS=1 EXPO_USE_DEVTOOLS=false bunx expo start -c",
    "start:android": "EXPO_NO_DEV_TOOLS=1 EXPO_USE_DEVTOOLS=false bunx expo start --android",
    "start:ios": "EXPO_NO_DEV_TOOLS=1 EXPO_USE_DEVTOOLS=false bunx expo start --ios",
    "apk": "bunx eas build --platform android --profile preview --clear-cache",
    "apk:prod": "bunx eas build --platform android --profile production-apk --clear-cache",
    "apk:local": "bunx eas build --platform android --profile preview --local",
    "aab": "bunx eas build --platform android --profile production --clear-cache",
    "apple": "bunx eas build --platform ios --profile development"
  },
  "private": true,
  "dependencies": {
    "@expo/metro-runtime": "^57.0.9",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.19.0",
    "expo": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "^57.0.1",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "0.468.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "expo-system-ui": "^57.0.2",
    "typescript": "~6.0.3"
  }
}