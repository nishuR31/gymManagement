# Your API's local IP address or production URL
EXPO_PUBLIC_API_URL="http://192.168.1.100:4000"

# The name of the application
EXPO_PUBLIC_APP_NAME="Valor Fitness"

# Set to true if you are running without the backend API
EXPO_PUBLIC_USE_MOCK_API=false

# Expo development tooling configuration
EXPO_NO_DEV_TOOLS=1
