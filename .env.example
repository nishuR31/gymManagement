# --- DATABASE ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_DB=gym
DATABASE_URL="postgresql://user:password@host:5432/gym?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/gym?sslmode=require"

# --- REDIS ---
REDIS_URL="rediss://default:password@host:6379"

# --- AUTH & SECURITY ---
# Generate a strong secret (e.g., using `openssl rand -base64 32`)
JWT_ACCESS_SECRET="your_very_long_and_secure_jwt_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS="30"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# --- API & WEB CONFIG ---
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false" # Set to true in production
API_PORT="4000"
WEB_PORT="5173"

# --- GYM OWNER (Default Admin) ---
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="ChangeMe123!"
OWNER_FIRST_NAME="Gym"
OWNER_LAST_NAME="Owner"

# --- FRONTEND (Vite) ---
VITE_APP_NAME="Valor Fitness"

# --- PASSKEYS / WEBAUTHN ---
# For local dev, origin is the web URL and RP_ID is "localhost"
PASSKEY_EXPECTED_ORIGIN="http://localhost:5173"
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="Valor Fitness"
