# Root Compose defaults. App-specific examples live in apps/api/.env.example and apps/web/.env.example.
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gym
API_PORT=4000
WEB_PORT=5173
VITE_API_URL=http://localhost:4000

DATABASE_URL=postgresql://gym:change-me@postgres:5432/gym?schema=public
DIRECT_URL=postgresql://gym:change-me@postgres:5432/gym?schema=public
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-before-use
OWNER_FIRST_NAME=Gym
OWNER_LAST_NAME=Owner
VITE_APP_NAME=Valor
